*.mot

# ============ Keil 用户/临时文件 ============
# 窗口布局(含本机用户名与绝对路径)
*.uvguix.*
# J-Link 日志
JLinkLog.txt
# UV4 命令行编译日志
build_log.txt
# 他人/CI 构建校验日志(非源码)
build_verify.log
*.bak
*.tmp
*~

# ============ 编辑器 / 系统 ============
.vscode/
.idea/
.DS_Store
Thumbs.db

